# ==========================================================
# VARIABLES DE PRODUCCIÓN (copiar a ".env" en el servidor)
# NUNCA subir el ".env" real al repositorio.
# ==========================================================

# --- HTTPS (RNF-014) ---
ACME_EMAIL=correo@tu-dominio.com
APP_DOMAIN=app.tu-dominio.com
API_DOMAIN=api.tu-dominio.com
LANDING_DOMAIN=tu-dominio.com

# --- MinIO (cambiar SIEMPRE los valores de desarrollo) ---
MINIO_ROOT_USER=cambia_este_usuario
MINIO_ROOT_PASSWORD=cambia_esta_clave_larga_y_unica

# --- Cifrado en reposo de archivos (RNF-013) ---
# Generar UNA vez y guardar una copia fuera del servidor (gestor de
# contraseñas). Si se pierde, los archivos cifrados NO se pueden leer:
#   python -c "import secrets,base64;print('raccord-key:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# Rotación (cada 90 días): ver SEGURIDAD_OPERACION.md
MINIO_KMS_SECRET_KEY=raccord-key:GENERAR_UNA_NUEVA
