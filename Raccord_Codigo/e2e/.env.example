# Copia este archivo a ".env" y completa los valores (NO subir ".env" a git).
API_URL=http://localhost:8000
WEB_URL=http://localhost:8081

# Proyecto de PRUEBA donde existen los usuarios de abajo (id_project UUID)
PROJECT_ID=

# Un usuario por rol dentro de ese proyecto. Los que no se llenen,
# sus pruebas se saltan (skip).
ADMIN_MAIL=
ADMIN_PASS=
DIRECTOR_MAIL=
DIRECTOR_PASS=
JEFE_MAIL=
JEFE_PASS=
ONSET_MAIL=
ONSET_PASS=
USUARIO_MAIL=
USUARIO_PASS=
